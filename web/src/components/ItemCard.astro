---
const { item } = Astro.props;
---

<div
  class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow"
>
  <div class="flex flex-col items-center text-center">
    <h3 class="text-sm font-medium text-gray-900 mb-2">{item.name}</h3>
    <div class="flex items-center space-x-2">
      <button
        type="button"
        class="decrease-qty w-8 h-8
        bg-gray-200 hover:bg-gray-300 rounded-full
        flex items-center justify-center
        text-sm font-medium"
        @click={`$store.createTask.removeItem('${item.id}')`}
      >
        -
      </button>
      <span
        class="quantity-display w-12 text-center text-sm font-medium"
        x-text={`$store.createTask.requirements['${item.id}'] || 0`}
      >
        0
      </span>
      <button
        type="button"
        class="increase-qty w-8 h-8 bg-blue-600 hover:bg-blue-700 text-white rounded-full flex items-center justify-center text-sm font-medium"
        @click={`$store.createTask.addItem('${item.id}')`}
      >
        +
      </button>
    </div>
  </div>
</div>
