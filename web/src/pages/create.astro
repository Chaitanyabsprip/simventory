---
import Layout from "../layouts/Layout.astro";

import type { Item } from "../scripts/tasks.ts";
import { getCollection } from "astro:content";
import ItemCard from "../components/ItemCard.astro";
import ItemSummaryCard from "../components/ItemSummaryCard.astro";
const itemCollections = await getCollection("items");
const items: Item[] = itemCollections.map((item) => item.data);
---

<Layout>
  <Fragment slot="head">
    <script>
      import { createTaskInit } from "../scripts/init.ts";
      createTaskInit();
    </script>
  </Fragment>
</Layout>

<h1 class="text-4xl font-bold my-16">Create New Task</h1>
<form id="task-form" class="space-y-6 pb-24" x-data>
  <div>
    <input
      type="text"
      id="task-name"
      name="task-name"
      required
      class="w-full px-3 py-2
        border border-gray-300
        rounded-md shadow-sm
        focus:outline-none focus:ring-2
        focus:ring-blue-500 focus:border-blue-500"
      placeholder="Enter task name"
      @input="$store.createTask.name = $event.target.value"
    />
  </div>
  <div>
    <div
      id="summary"
      class="mb-4 p-4 border-[0.5px] border-gray-100 rounded-lg text-sm shadow-sm text-gray-700"
    >
      <template x-if="!$store.createTask.hasRequirements()">
        <p class="text-gray-500">No items selected</p>
      </template>
      <div class="grid grid-cols-10 gap-4">
        <template
          id="selected-items-grid"
          x-for="(qty, itemId) in $store.createTask.requirements"
          :key="itemId"
        >
          <ItemSummaryCard />
        </template>
      </div>
    </div>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4
        overflow-y-auto max-h-screen"
      id="items-grid"
    >
      {items.map((item) => <ItemCard {item} />)}
    </div>
  </div>
</form>

<div
  class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 z-10"
>
  <div x-data class="max-w-md mx-auto flex gap-4">
    <button
      type="button"
      @click="window.location.href='/'"
      class="flex-1 px-6 py-3
      bg-gray-200 rounded-lg hover:bg-gray-100
      focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2
      border border-gray-300
      font-medium text-lg shadow-lg"
    >
      Cancel
    </button>
    <button
      type="submit"
      form="task-form"
      @click.prevent="if ($store.createTask.complete()) { window.location.href='/' }"
      class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 font-medium text-lg shadow-lg"
    >
      Create Task
    </button>
  </div>
</div>
